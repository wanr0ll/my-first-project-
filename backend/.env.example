# ============================================================
# GHA Asset Manager - Backend Environment Configuration
# ============================================================

# To connect to Supabase PostgreSQL:
# 1. Go to Supabase Dashboard -> Project Settings -> Database
# 2. Copy your Connection String (URI format or individual fields)
# 3. Paste below as DATABASE_URL:

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Or set individual credentials:
# DB_DRIVER=pgsql
# PGHOST=db.[YOUR-PROJECT-REF].supabase.co
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=postgres
# PGPORT=5432

# CORS & Application URLs
FRONTEND_URL=https://ghaassetmanager.netlify.app
CORS_ALLOW_ALL=true
