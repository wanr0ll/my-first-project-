# ============================================================
# GHA Asset Manager — Node.js Backend Environment Configuration
# Stack: Node.js (Express) + Supabase (PostgreSQL) + Netlify (React Frontend)
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Supabase PostgreSQL Database ─────────────────────────────
# In Supabase Dashboard:
# Project Settings → Database → Connection String (URI)
# Note: For cloud hosts without IPv6 support (such as Render free tier),
# use the "Session" or "Transaction" connection pooler URL (aws-0-*.pooler.supabase.com:6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Alternatively, set individual connection parameters:
# PGHOST=db.[YOUR-PROJECT-REF].supabase.co
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=postgres
# PGPORT=5432

# ── Server Configuration ─────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS & Application URLs ──────────────────────────────────
# Your Netlify frontend URL (no trailing slash)
FRONTEND_URL=https://ghaassetmanager.netlify.app
CORS_ALLOW_ALL=false

# ── Auth (JWT) ───────────────────────────────────────────────
# A long random string for signing JWT tokens
JWT_SECRET=your_very_long_random_secret_here

# ── Email (Brevo) ─────────────────────────────────────────────
# Required for password reset and email verification OTPs
BREVO_API_KEY=your_brevo_api_key_here
SMTP_FROM=ghaassetmanagementsystem@gmail.com
SMTP_FROM_NAME="Ghana Highway Authority"
