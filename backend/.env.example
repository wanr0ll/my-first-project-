# ============================================================
# GHA Asset Manager — Backend Environment Configuration
# Stack: Render (PHP backend) + Supabase (PostgreSQL) + Netlify (frontend)
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Supabase PostgreSQL ──────────────────────────────────────
# Go to: Supabase Dashboard → Project Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Or set individual credentials instead of DATABASE_URL:
# DB_DRIVER=pgsql
# PGHOST=db.[YOUR-PROJECT-REF].supabase.co
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=postgres
# PGPORT=5432

# ── CORS & Application URLs ──────────────────────────────────
# Set to your Netlify frontend URL (no trailing slash)
FRONTEND_URL=https://your-site.netlify.app
CORS_ALLOW_ALL=false

# ── Auth ──────────────────────────────────────────────────────
# A long random string for signing JWT tokens
JWT_SECRET=your_very_long_random_secret_here

# ── Email (Brevo) ─────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
